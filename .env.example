# Passwords for AdGuard Home hosts.
# These names must match the ${VAR} references in config.yaml (or the auto-seeded defaults).
ADGUARD_PRIMARY_PASSWORD=
ADGUARD_FOLLOWER_A_PASSWORD=

# Optional: protect the dashboard with HTTP Basic Auth.
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=

# Optional: exact browser-facing origins, comma-separated. Preserve Host at the proxy.
# DASHBOARD_ALLOWED_ORIGINS=https://sync.example.local,https://sync.example.local:8443

# Advanced overrides (rarely needed)
# DATABASE_PATH=/data/adguard-sync.db
